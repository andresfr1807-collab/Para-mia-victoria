<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Para Mia Victoria ❤️</title>

<style>
* {
    box-sizing: border-box;
}

body {
    margin: 0;
    min-height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 20px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    background: linear-gradient(135deg, #ffdce8, #fff5f8);
    color: #3b2730;
}

.card {
    width: 100%;
    max-width: 520px;
    background: rgba(255,255,255,0.96);
    border-radius: 28px;
    padding: 30px 24px;
    text-align: center;
    box-shadow: 0 18px 50px rgba(120,40,70,0.18);
}

.heart {
    font-size: 52px;
    animation: latido 1.5s infinite;
}

@keyframes latido {
    50% {
        transform: scale(1.15);
    }
}

h1 {
    font-size: 30px;
    margin: 5px 0 15px;
}

h2 {
    font-size: 24px;
    margin: 15px 0;
}

p {
    font-size: 17px;
    line-height: 1.6;
}

.progress {
    height: 8px;
    background: #f1dbe3;
    border-radius: 20px;
    margin: 20px 0;
    overflow: hidden;
}

.bar {
    height: 100%;
    width: 25%;
    background: #e85d87;
    border-radius: 20px;
    transition: 0.4s;
}

.screen {
    display: none;
}

.screen.active {
    display: block;
}

button {
    border: none;
    border-radius: 18px;
    padding: 14px 24px;
    margin: 8px;
    font-size: 17px;
    cursor: pointer;
    background: #e85d87;
    color: white;
    box-shadow: 0 6px 15px rgba(232,93,135,0.25);
}

button:active {
    transform: scale(0.96);
}

button.no {
    background: #f1e3e8;
    color: #663b4b;
}

#answer {
    min-height: 70px;
    margin-top: 18px;
    font-size: 17px;
    line-height: 1.6;
    font-weight: 600;
}

.footer {
    margin-top: 25px;
    font-size: 13px;
    color: #80636e;
}
</style>
</head>

<body>

<div class="card">

    <div class="heart">❤️</div>

    <h1>Para Mia Victoria</h1>

    <div class="progress">
        <div class="bar" id="bar"></div>
    </div>


    <!-- PANTALLA 1 -->

    <section class="screen active" id="s1">

        <h2>Una pequeña historia...</h2>

        <p>
            Hola, Mia. ❤️
        </p>

        <p>
            Pablo Andrés preparó este pequeño juego
            para decirte algo que quizá le costaba
            decirte de frente.
        </p>

        <button onclick="next(2)">
            Continuar ❤️
        </button>

    </section>


    <!-- PANTALLA 2 -->

    <section class="screen" id="s2">

        <h2>Una pista...</h2>

        <p>
            Hay una persona que se ha vuelto
            muy especial para Pablo Andrés.
        </p>

        <p>
            Alguien con quien le gusta hablar,
            compartir momentos y simplemente estar.
        </p>

        <button onclick="next(3)">
            Siguiente ❤️
        </button>

    </section>


    <!-- PANTALLA 3 -->

    <section class="screen" id="s3">

        <h2>Otra pista...</h2>

        <p>
            Cuando Pablo Andrés piensa en esa persona,
            aparece una sonrisa.
        </p>

        <p>
            Y sí...
        </p>

        <p>
            <strong>
                Esa persona eres tú, Mia. ❤️
            </strong>
        </p>

        <button onclick="next(4)">
            Ya casi... ❤️
        </button>

    </section>


    <!-- PANTALLA 4 -->

    <section class="screen" id="s4">

        <h2>Quería decirte algo...</h2>

        <p>
            Quería encontrar una forma especial
            de decirte esto porque eres alguien
            muy especial para mí.
        </p>

        <p>
            Me encanta compartir momentos contigo,
            hablar contigo y tenerte en mi vida.
            Con el tiempo me di cuenta de que
            lo que siento por ti es mucho más
            que una simple amistad.
        </p>

        <p>
            <strong>
                Me gustas mucho, Mia. ❤️
            </strong>
        </p>

        <p>
            Quiero preguntarte algo que para mí
            significa mucho:
        </p>

        <h2>
            ¿Quieres ser mi novia? ❤️
        </h2>

        <button onclick="respuestaSi()">
            Sí ❤️
        </button>

        <button class="no" onclick="respuestaNo()">
            No
        </button>

        <div id="answer"></div>

    </section>


    <div class="footer">
        Hecho con cariño por Pablo Andrés ❤️
    </div>

</div>


<script>

function next(numero) {

    document
        .querySelectorAll(".screen")
        .forEach(function(pantalla) {
            pantalla.classList.remove("active");
        });

    document
        .getElementById("s" + numero)
        .classList.add("active");

    document
        .getElementById("bar")
        .style.width = (numero * 25) + "%";

    window.scrollTo({
        top: 0,
        behavior: "smooth"
    });
}


function respuestaSi() {

    document.getElementById("answer").innerHTML =
        "🥹❤️ ¡Me hiciste muy feliz, Mia!<br><br>" +
        "Gracias por darme una oportunidad. " +
        "Prometo cuidar cada momento que compartamos." +
        "<br><br>" +
        "— Pablo Andrés ❤️";

}


function respuestaNo() {

    document.getElementById("answer").innerHTML =
        "Gracias por ser sincera, Mia. ❤️<br><br>" +
        "Lo más importante para Pablo Andrés " +
        "era poder decirte lo que siente y respetar " +
        "tu respuesta.<br><br>" +
        "Gracias por llegar hasta el final.";

}

</script>

</body>
			</html>